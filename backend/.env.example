# Copy to .env and adjust as needed
DATABASE_URL="postgresql://mandimitra:mandimitra@localhost:5432/mandimitra?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Net Realisation Engine defaults (₹)
TRANSPORT_RATE_PER_KM_PER_QUINTAL=1.5
STORAGE_RATE_PER_DAY_PER_QUINTAL=2.0
