generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  FPO
  BUYER
  ADMIN
}

enum LotStatus {
  DRAFT
  LISTED
  AGGREGATED
  SOLD
  STORED
  WITHDRAWN
}

enum OfferStatus {
  OPEN
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum TransactionStatus {
  INITIATED
  PAYMENT_PENDING
  PAID
  IN_TRANSIT
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  DELAYED
  FAILED
}

enum GrievanceStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum SellTimingAdvice {
  SELL_NOW
  WAIT_FEW_DAYS
  SELL_PART_STORE_REST
}

/// Registered account. Buyers get an extra Buyer profile with reliability fields.
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole
  latitude  Float?
  longitude Float?
  address   String?
  village   String?
  district  String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyerProfile    Buyer?
  lots            Lot[]            @relation("FarmerLots")
  grievances      Grievance[]
  decisionQueries DecisionQuery[]
  fpoMemberships  FpoMember[]
  ledFpos         Fpo[]            @relation("FpoLead")
}

/// Buyer reliability profile — used by the trust-score calculator.
model Buyer {
  id                  String   @id @default(uuid())
  userId              String   @unique
  businessName        String
  gstin               String?
  minQualityGrade     String   @default("C")
  /// Fraction 0–1 of deals paid on or before the agreed date
  onTimePaymentRate   Float    @default(0.5)
  avgPaymentDelayDays Float    @default(7)
  totalDealsCompleted Int      @default(0)
  /// Cached 0–100 score; recalculated after each completed deal
  trustScore          Float    @default(50)
  latitude            Float?
  longitude           Float?
  address             String?
  district            String?
  state               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers       Offer[]
  transactions Transaction[]
}

model Crop {
  id        String   @id @default(uuid())
  name      String
  localName String?
  category  String?
  unit      String   @default("quintal")
  createdAt DateTime @default(now())

  marketPrices    MarketPrice[]
  lots            Lot[]
  offers          Offer[]
  decisionQueries DecisionQuery[]
}

model Market {
  id        String   @id @default(uuid())
  name      String
  mandiCode String?  @unique
  district  String
  state     String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  prices MarketPrice[]
}

/// One row per market × crop × day — historical series for trend calculation.
model MarketPrice {
  id         String   @id @default(uuid())
  marketId   String
  cropId     String
  date       DateTime
  minPrice   Float
  maxPrice   Float
  modalPrice Float
  arrivals   Float?
  createdAt  DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([marketId, cropId, date])
  @@index([cropId, date])
}

/// Farmer produce lot (may later be aggregated under an FPO).
model Lot {
  id                   String    @id @default(uuid())
  farmerId             String
  fpoId                String?
  cropId               String
  quantity             Float
  qualityGrade         String
  harvestDate          DateTime
  location             String
  latitude             Float?
  longitude            Float?
  hasStorage           Boolean   @default(false)
  storageDaysAvailable Int?
  status               LotStatus @default(DRAFT)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  farmer       User          @relation("FarmerLots", fields: [farmerId], references: [id])
  fpo          Fpo?          @relation(fields: [fpoId], references: [id])
  crop         Crop          @relation(fields: [cropId], references: [id])
  offers       Offer[]
  transactions Transaction[]
}

/// Digital buyer offer against a crop (optionally a specific lot).
model Offer {
  id             String      @id @default(uuid())
  buyerId        String
  lotId          String?
  cropId         String
  quantity       Float
  offerPrice     Float
  minGrade       String      @default("C")
  validUntil     DateTime?
  pickupLocation String?
  latitude       Float?
  longitude      Float?
  status         OfferStatus @default(OPEN)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  buyer        Buyer         @relation(fields: [buyerId], references: [id])
  lot          Lot?          @relation(fields: [lotId], references: [id])
  crop         Crop          @relation(fields: [cropId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id              String            @id @default(uuid())
  lotId           String
  offerId         String
  buyerId         String
  quantity        Float
  agreedPrice     Float
  transportCost   Float?
  paymentStatus   PaymentStatus     @default(PENDING)
  paymentDate     DateTime?
  expectedPayDate DateTime?
  logisticsStatus String?
  status          TransactionStatus @default(INITIATED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lot        Lot         @relation(fields: [lotId], references: [id])
  offer      Offer       @relation(fields: [offerId], references: [id])
  buyer      Buyer       @relation(fields: [buyerId], references: [id])
  grievances Grievance[]
}

model Grievance {
  id            String          @id @default(uuid())
  userId        String
  transactionId String?
  subject       String
  description   String
  status        GrievanceStatus @default(OPEN)
  resolution    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
}

model Fpo {
  id         String   @id @default(uuid())
  name       String
  leadUserId String
  district   String?
  state      String?
  createdAt  DateTime @default(now())

  lead    User        @relation("FpoLead", fields: [leadUserId], references: [id])
  members FpoMember[]
  lots    Lot[]
}

model FpoMember {
  id       String   @id @default(uuid())
  fpoId    String
  userId   String
  joinedAt DateTime @default(now())

  fpo  Fpo  @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fpoId, userId])
}

/// Logs every decision-engine request + recommendation for a later feedback / ML dataset.
model DecisionQuery {
  id                       String            @id @default(uuid())
  farmerId                 String?
  cropId                   String
  quantity                 Float
  qualityGrade             String
  location                 String
  latitude                 Float?
  longitude                Float?
  harvestDate              DateTime?
  hasStorage               Boolean           @default(false)
  sellTimingRecommendation SellTimingAdvice?
  reasoning                String?
  rankedOptions            Json?
  createdAt                DateTime          @default(now())

  farmer User? @relation(fields: [farmerId], references: [id])
  crop   Crop  @relation(fields: [cropId], references: [id])

  @@index([cropId, createdAt])
}
